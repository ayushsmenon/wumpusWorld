DATABASE_URL=postgresql://user:password@localhost:5432/wumpus
# Local embeddings are the default. The model must be downloaded during setup.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_CACHE_DIR=
EMBEDDING_DEVICE=cpu
# OpenAI is explicit opt-in only and is not used by default.
OPENAI_API_KEY=